# Evaluation image for the document parser: runs `src.eval_cli` once and exits.
# No Redis, BullMQ, MinIO, Postgres or parser consumer is started.
#
#   docker build -f Dockerfile.eval --build-arg EXTRACTOR_COMMIT=$(git rev-parse --short HEAD) \
#     -t whimsync-extractor-eval:<sha> .
#   docker run --rm -v "$PWD/case:/input:ro" -v "$PWD/out:/output" -e GEMINI_API_KEY \
#     whimsync-extractor-eval:<sha> --input /input/source.pdf --tier balanced --output /output
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    HOME=/tmp \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Dependencies first (cached across source changes), from the committed lockfile.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src

ARG EXTRACTOR_COMMIT=unknown
ENV EXTRACTOR_COMMIT=${EXTRACTOR_COMMIT}

ENTRYPOINT ["python", "-m", "src.eval_cli"]
